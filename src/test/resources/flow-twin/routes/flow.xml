<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- Entry: R9.14_apiT branches (OR) to two distinct release routes, both hitting /shared at svc 2.0. -->
    <route id="R9.14_apiT">
        <from uri="direct:R9.14_apiT"/>
        <choice>
            <when>
                <simple>${exchangeProperty[transferType]} == 'OWN'</simple>
                <to uri="direct:R9.14_routeX"/>
            </when>
            <when>
                <simple>${exchangeProperty[transferType]} == 'ALT'</simple>
                <to uri="direct:R9.14_routeY"/>
            </when>
        </choice>
    </route>

    <!-- RouteX: /shared at serviceVersionNumber 2.0 (one payload flavour). -->
    <route id="R9.14_routeX">
        <from uri="direct:R9.14_routeX"/>
        <to uri="framework:META-INF/templates/rt/precapture.ftl"/>
        <setProperty name="api"><simple>/shared</simple></setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

    <!-- RouteY: the SAME backend /shared at the SAME serviceVersionNumber 2.0 (different payload logic). -->
    <route id="R9.14_routeY">
        <from uri="direct:R9.14_routeY"/>
        <to uri="framework:META-INF/templates/rt/precapture.ftl"/>
        <setProperty name="api"><simple>/shared</simple></setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

    <route id="callUFWDGE">
        <from uri="direct:callUFWDGE"/>
        <to uri="https://host/ufw/dispatch"/>
    </route>

</routes>
