<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- 9.14 (built from R9.8): SAME flow + SAME backend service version (2.0); the template only ADDS
         request fields C+D (no removals). Backward compatible and scoped to the new app version. -->
    <route id="R9.14_addApi">
        <from uri="direct:R9.14_addApi"/>
        <to uri="framework:META-INF/templates/add/v914/precapture.ftl"/>
        <setProperty name="api">
            <simple>{{baseUrl}}/svc/add</simple>
        </setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

</routes>
