<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- 9.5: identical flow and identical payload keys to 9.4 — ONLY the backend
         serviceVersionNumber the request template carries differs (2.3 vs 2.2). This
         is the "backend service-version bump only" case: no payload change, no BAU
         class change, so risk must be Medium (scoped to the new route). -->
    <route id="R9.5_bumpApi">
        <from uri="direct:R9.5_bumpApi"/>
        <to uri="framework:META-INF/templates/bump/v95/precapture.ftl"/>
        <setProperty name="api">
            <simple>{{baseUrl}}/svc/bump</simple>
        </setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

</routes>
