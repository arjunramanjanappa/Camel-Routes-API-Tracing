<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- Entry: R9.14_apiA. Always calls the 9.14 backend /myInfo, then branches:
         when → 9.14 /fetch (change), otherwise → resolved-down BAU R9.10_callGet (/getLegacy). -->
    <route id="R9.14_apiA">
        <from uri="direct:R9.14_apiA"/>
        <to uri="direct:R9.14_callMyInfo"/>
        <choice>
            <when>
                <simple>${header.branch} == 'fetch'</simple>
                <to uri="direct:R9.14_callFetch"/>
            </when>
            <otherwise>
                <to uri="direct:R9.10_callGet"/>
            </otherwise>
        </choice>
    </route>

    <!-- 9.14 change, UNCONDITIONAL (before the choice): /myInfo at serviceVersionNumber 4.0. -->
    <route id="R9.14_callMyInfo">
        <from uri="direct:R9.14_callMyInfo"/>
        <to uri="framework:META-INF/templates/myInfo/precapture.ftl"/>
        <setProperty name="api"><simple>/myInfo</simple></setProperty>
        <to uri="direct:callBackend"/>
    </route>

    <!-- 9.14 change, conditional (when branch): /fetch at serviceVersionNumber 4.1. -->
    <route id="R9.14_callFetch">
        <from uri="direct:R9.14_callFetch"/>
        <to uri="framework:META-INF/templates/fetch/precapture.ftl"/>
        <setProperty name="api"><simple>/fetch</simple></setProperty>
        <to uri="direct:callBackend"/>
    </route>

    <!-- BAU: R9.10 is resolved-down for a 9.14 release. Its OWN distinct backend /getLegacy at 2.0, and it
         sets its own service version (like the real design). Reached only via the otherwise branch. -->
    <route id="R9.10_callGet">
        <from uri="direct:R9.10_callGet"/>
        <to uri="framework:META-INF/templates/getLegacy/precapture.ftl"/>
        <setProperty name="api"><simple>/getLegacy</simple></setProperty>
        <to uri="direct:callBackend"/>
    </route>

    <route id="callBackend">
        <from uri="direct:callBackend"/>
        <to uri="https://host/ufw/dispatch"/>
    </route>

</routes>
