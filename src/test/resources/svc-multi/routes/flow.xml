<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <!-- Entry: R9.14_apiA calls three distinct RELEASE-version (9.14) child routes — all must be tested. -->
    <route id="R9.14_apiA">
        <from uri="direct:R9.14_apiA"/>
        <to uri="direct:R9.14_routeB"/>
        <to uri="direct:R9.14_routeC"/>
        <to uri="direct:R9.14_routeD"/>
    </route>

    <!-- RouteB: /getStatus at serviceVersionNumber 4.0. -->
    <route id="R9.14_routeB">
        <from uri="direct:R9.14_routeB"/>
        <to uri="framework:META-INF/templates/rb/precapture.ftl"/>
        <setProperty name="api"><simple>/getStatus</simple></setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

    <!-- RouteC: /fetchStatus at serviceVersionNumber 4.1. -->
    <route id="R9.14_routeC">
        <from uri="direct:R9.14_routeC"/>
        <to uri="framework:META-INF/templates/rc1/precapture.ftl"/>
        <setProperty name="api"><simple>/fetchStatus</simple></setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

    <!-- RouteD: a DISTINCT backend /putStatus at serviceVersionNumber 2.0 (still a 9.14 release flow). -->
    <route id="R9.14_routeD">
        <from uri="direct:R9.14_routeD"/>
        <to uri="framework:META-INF/templates/rc2/precapture.ftl"/>
        <setProperty name="api"><simple>/putStatus</simple></setProperty>
        <to uri="direct:callUFWDGE"/>
    </route>

    <route id="callUFWDGE">
        <from uri="direct:callUFWDGE"/>
        <to uri="https://host/ufw/dispatch"/>
    </route>

</routes>
